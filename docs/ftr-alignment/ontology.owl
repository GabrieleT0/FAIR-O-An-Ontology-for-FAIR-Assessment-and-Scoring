     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/"
     xmlns:nschema="http://www.nanopub.org/nschema#"
     xmlns:ftr-alignment="https://w3id.org/fair-o/ftr-alignment#">
    <owl:Ontology rdf:about="https://w3id.org/fair-o/ftr-alignment">
        <owl:imports rdf:resource="https://w3id.org/fair-o"/>
        <terms:abstract xml:lang="en">Conservative class-level correspondences and explicit data-level bridges between FAIR-O and FTR 1.3.0.</terms:abstract>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-15</terms:created>
        <terms:description xml:lang="en">Conservative class-level correspondences and explicit data-level bridges between FAIR-O and FTR 1.3.0.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">FAIR-O to FTR Alignment Module</terms:title>
        <rdfs:seeAlso rdf:resource="https://w3id.org/ftr#"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/ftr/1.3.0"/>
    </owl:Ontology>
    


