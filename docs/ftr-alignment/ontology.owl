    <!-- https://w3id.org/fair-o/ftr-alignment#relatedClass -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/fair-o/ftr-alignment#relatedClass">
        <rdfs:comment xml:lang="en">Conceptually related class in an external ontology, does not entail class equivalence or subclass membership.</rdfs:comment>
        <rdfs:label xml:lang="en">related OWL class</rdfs:label>
    </owl:AnnotationProperty>
    


