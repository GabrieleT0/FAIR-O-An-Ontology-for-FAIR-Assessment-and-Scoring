@prefix : <http://w3id.org/fair-o-shapes#> .
@prefix fairo: <https://w3id.org/fair-o#> .
@prefix fairVocab: <https://w3id.org/fair/principles/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .


# FAIR Assessment Shape

:FAIRAssessmentShape
    a sh:NodeShape ;
    sh:targetClass fairo:FAIRAssessment ;

    sh:property [
        sh:path fairo:fairScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 4.0 ;
        sh:message "A FAIR assessment must have exactly one overall FAIR score between 0 and 4." ;
    ] ;

    sh:property [
        sh:path fairo:fScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "A FAIR assessment must have exactly one Findable score between 0 and 1." ;
    ] ;

    sh:property [
        sh:path fairo:aScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "A FAIR assessment must have exactly one Accessible score between 0 and 1." ;
    ] ;

    sh:property [
        sh:path fairo:iScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "A FAIR assessment must have exactly one Interoperable score between 0 and 1." ;
    ] ;

    sh:property [
        sh:path fairo:rScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "A FAIR assessment must have exactly one Reusable score between 0 and 1." ;
    ] ;

    sh:property [
        sh:path fairo:hasSubPrincipleResult ;
        sh:class fairo:SubPrincipleResult ;
        sh:minCount 1 ;
        sh:message "A FAIR assessment must have at least one sub-principle result." ;
    ] ;

    sh:property [
        sh:path fairo:usesAggregationMethod ;
        sh:class fairo:AggregationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A FAIR assessment must use exactly one aggregation method." ;
    ] ;

    sh:property [
        sh:path prov:used ;
        sh:class prov:Entity ;
        sh:minCount 1 ;
        sh:message "A FAIR assessment must declare at least one assessed resource using prov:used." ;
    ] ;

    sh:property [
        sh:path prov:startedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A FAIR assessment must have exactly one valid start time as xsd:dateTime." ;
    ] ;

    sh:property [
        sh:path prov:endedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A FAIR assessment must have exactly one valid end time as xsd:dateTime." ;
    ] ;

    sh:property [
        sh:path [ sh:inversePath fairo:wasAssessedBy ] ;
        sh:minCount 1 ;
        sh:message "Every FAIR assessment must be linked from at least one assessed resource through fairo:wasAssessedBy." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The assessment start time must not be later than the assessment end time." ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>

            SELECT $this
            WHERE {
                $this prov:startedAtTime ?start ;
                      prov:endedAtTime ?end .
                FILTER (?start > ?end)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The overall FAIR score must not be greater than the sum of the F, A, I, and R scores." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:fairScore ?fair ;
                      fairo:fScore ?f ;
                      fairo:aScore ?a ;
                      fairo:iScore ?i ;
                      fairo:rScore ?r .
                FILTER (?fair > (?f + ?a + ?i + ?r))
            }
        """ ;
    ] .

# Assessed Resource Shape

:AssessedResourceShape
    a sh:NodeShape ;
    sh:targetSubjectsOf fairo:wasAssessedBy ;

    sh:property [
        sh:path fairo:wasAssessedBy ;
        sh:class fairo:FAIRAssessment ;
        sh:minCount 1 ;
        sh:message "A resource assessed by fairo:wasAssessedBy must point to a FAIR assessment." ;
    ] .


# Sub-Principle Result Shape

:SubPrincipleResultShape
    a sh:NodeShape ;
    sh:targetClass fairo:SubPrincipleResult ;

    sh:property [
        sh:path fairo:forSubPrinciple ;
        sh:nodeKind sh:IRI ;
        sh:class fairVocab:FAIR-SubPrinciple ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A sub-principle result must refer to exactly one FAIR sub-principle." ;
    ] ;

    sh:property [
        sh:path fairo:testResult ;
        sh:in (
            fairo:Pass
            fairo:Fail
            fairo:Indeterminate
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A sub-principle result must have exactly one test outcome: Pass, Fail, or Indeterminate." ;
    ] ;

    sh:property [
        sh:path fairo:assessmentScope ;
        sh:in (
            fairo:DataScope
            fairo:MetadataScope
            fairo:DataAndMetadata
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A sub-principle result must specify exactly one assessment scope." ;
    ] ;

    sh:property [
        sh:path fairo:value ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "A sub-principle result must have exactly one decimal value between 0 and 1." ;
    ] ;

    sh:property [
        sh:path fairo:evidence ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "A sub-principle result must include non-empty textual evidence." ;
    ] ;

    sh:property [
        sh:path fairo:computedUsing ;
        sh:class fairo:CalculationAlgorithm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every sub-principle result must be computed using exactly one calculation algorithm." ;
    ] ;

    sh:property [
        sh:path [ sh:inversePath fairo:hasSubPrincipleResult ] ;
        sh:class fairo:FAIRAssessment ;
        sh:minCount 1 ;
        sh:message "Every sub-principle result must be linked from at least one FAIR assessment." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If testResult is Pass, the value must be exactly 1.0." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:testResult fairo:Pass ;
                      fairo:value ?value .
                FILTER (?value != 1.0)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If testResult is Fail, the value must be exactly 0.0." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:testResult fairo:Fail ;
                      fairo:value ?value .
                FILTER (?value != 0.0)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If testResult is Indeterminate, the value must be greater than 0 and less than 1." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:testResult fairo:Indeterminate ;
                      fairo:value ?value .
                FILTER (?value <= 0.0 || ?value >= 1.0)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The assessment scope of a sub-principle result must be consistent with the scope declared for the corresponding FAIR sub-principle, when such scope is declared." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:forSubPrinciple ?subPrinciple ;
                      fairo:assessmentScope ?resultScope .

                ?subPrinciple fairo:appliesTo ?expectedScope .

                FILTER (?resultScope != ?expectedScope)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each sub-principle result must have a complete computation chain: calculation algorithm, scoring function, and implementing software agent." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:computedUsing ?algorithm .
                FILTER (
                    NOT EXISTS { ?algorithm fairo:appliesScoringFunction ?scoringFunction . }
                    ||
                    NOT EXISTS { ?algorithm fairo:implementedBy ?softwareAgent . }
                )
            }
        """ ;
    ] .

# Assessment Scope Shape

:AssessmentScopeShape
    a sh:NodeShape ;
    sh:targetClass fairo:AssessmentScope ;

    sh:in (
        fairo:DataScope
        fairo:MetadataScope
        fairo:DataAndMetadata
    ) ;

    sh:message "Assessment scope must be one of DataScope, MetadataScope, or DataAndMetadata." .


# Test Outcome Shape

:TestOutcomeShape
    a sh:NodeShape ;
    sh:targetClass fairo:TestOutcome ;

    sh:in (
        fairo:Pass
        fairo:Fail
        fairo:Indeterminate
    ) ;

    sh:message "Test outcome must be one of Pass, Fail, or Indeterminate." .


# FAIR Sub-Principle Shape

:FAIRSubPrincipleShape
    a sh:NodeShape ;
    sh:targetClass fairVocab:FAIR-SubPrinciple ;

    sh:property [
        sh:path fairo:appliesTo ;
        sh:in (
            fairo:DataScope
            fairo:MetadataScope
            fairo:DataAndMetadata
        ) ;
        sh:maxCount 1 ;
        sh:message "A FAIR sub-principle may specify whether it applies to data, metadata, or both." ;
    ] .


# Scoring Function Shape

:ScoringFunctionShape
    a sh:NodeShape ;
    sh:targetClass fairo:ScoringFunction ;

    sh:property [
        sh:path fairo:minValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A scoring function must have exactly one minimum value." ;
    ] ;

    sh:property [
        sh:path fairo:maxValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A scoring function must have exactly one maximum value." ;
    ] ;

    sh:property [
        sh:path fairo:formula ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Every scoring function must have exactly one non-empty scoring formula." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The minimum value of a scoring function must not be greater than its maximum value." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:minValue ?min ;
                      fairo:maxValue ?max .
                FILTER (?min > ?max)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A scoring function used for FAIR-O sub-principle values must have a minimum value >= 0 and a maximum value <= 1." ;
        sh:select """
            PREFIX fairo: <https://w3id.org/fair-o#>

            SELECT $this
            WHERE {
                $this fairo:minValue ?min ;
                      fairo:maxValue ?max .
                FILTER (?min < 0.0 || ?max > 1.0)
            }
        """ ;
    ] .


# Calculation Algorithm Shape

:CalculationAlgorithmShape
    a sh:NodeShape ;
    sh:targetClass fairo:CalculationAlgorithm ;

    sh:property [
        sh:path fairo:algorithmDescription ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "A calculation algorithm must have a non-empty human-readable description." ;
    ] ;

    sh:property [
        sh:path fairo:sourceCode ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
        sh:message "Source code must be provided as a URI." ;
    ] ;

    sh:property [
        sh:path fairo:appliesScoringFunction ;
        sh:class fairo:ScoringFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every calculation algorithm must apply exactly one scoring function." ;
    ] ;

    sh:property [
        sh:path fairo:implementedBy ;
        sh:class prov:SoftwareAgent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every calculation algorithm must be linked to exactly one implementing software agent." ;
    ] ;

    sh:property [
        sh:path [ sh:inversePath fairo:computedUsing ] ;
        sh:minCount 1 ;
        sh:class fairo:SubPrincipleResult ;
        sh:message "Every calculation algorithm must be used by at least one sub-principle result through fairo:computedUsing." ;
    ] .

# Aggregation Method Shape

:AggregationMethodShape
    a sh:NodeShape ;
    sh:targetClass fairo:AggregationMethod ;

    sh:property [
        sh:path fairo:formula ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Every aggregation method must have exactly one non-empty formula." ;
    ] ;

    sh:property [
        sh:path [ sh:inversePath fairo:usesAggregationMethod ] ;
        sh:minCount 1 ;
        sh:class fairo:FAIRAssessment ;
        sh:message "Every aggregation method must be linked from at least one FAIR assessment through fairo:usesAggregationMethod." ;
    ] .