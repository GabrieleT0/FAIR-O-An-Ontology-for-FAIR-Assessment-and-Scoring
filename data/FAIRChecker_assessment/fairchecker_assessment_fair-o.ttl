:result_fairchecker_icane_score_F1A_2026-04-01 a fairo:SubPrincipleResult ;
    fairo:forSubPrinciple fairVocab:F1 ;
    fairo:assessmentScope fairo:DataAndMetadata ;
    fairo:value "1"^^xsd:decimal ;
    fairo:testResult fairo:Pass ;
    fairo:evidence "Metric score_F1A from results.csv returned raw FAIRChecker score 2 on a 0..2 scale; normalized FAIR-O value is 1." ;
