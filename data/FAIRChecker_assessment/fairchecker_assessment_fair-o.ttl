@prefix : <https://w3id.org/fair-o/resource/> .
@prefix fairo: <https://w3id.org/fair-o#> .
@prefix fairVocab: <https://w3id.org/fair/principles/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:faircheckerDiscreteScore a fairo:ScoringFunction ;
    rdfs:label "FAIRChecker discrete score normalization" ;
    fairo:formula "normalizedScore = rawScore / 2" ;
    dct:description "Normalizes FAIRChecker sub-principle scores from the native 0..2 scale to the FAIR-O 0..1 range." ;
    fairo:minValue "0"^^xsd:decimal ;
    fairo:maxValue "1"^^xsd:decimal .

:faircheckerAggregateNormalization a fairo:AggregationMethod ;
    rdfs:label "FAIRChecker aggregate normalization" ;
    fairo:formula "normalizedAggregate = rawAggregate / principleMaximum" ;
    dct:description "Normalizes FAIRChecker principle and overall totals by dividing each raw aggregate by its maximum attainable value." .

:FAIRChecker a prov:SoftwareAgent ;
    rdfs:label "FAIRChecker" .

:algorithm_score_F1A a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker F1A score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the F1A check." .

:algorithm_score_F1B a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker F1B score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the F1B check." .

:algorithm_score_F2A a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker F2A score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the F2A check." .

:algorithm_score_F2B a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker F2B score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the F2B check." .

:algorithm_score_A1.1 a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker A1.1 score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the A1.1 check." .

:algorithm_score_A1.2 a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker A1.2 score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the A1.2 check." .

:algorithm_score_I1 a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker I1 score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the I1 check." .

:algorithm_score_I2 a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker I2 score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the I2 check." .

:algorithm_score_I3 a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker I3 score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the I3 check." .

:algorithm_score_R1.1 a fairo:CalculationAlgorithm ;
    rdfs:label "FAIRChecker R1.1 score" ;
    fairo:implementedBy :FAIRChecker ;
    fairo:appliesScoringFunction :faircheckerDiscreteScore ;
    fairo:algorithmDescription "FAIRChecker score for the R1.1 check." .

:algorithm_score_R1.2 a fairo:CalculationAlgorithm ;
