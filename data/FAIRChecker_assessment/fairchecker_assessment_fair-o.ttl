:dataset_icane a void:Dataset, prov:Entity ;
    dct:title "icane" ;
    dct:identifier "icane" ;
    dct:source <https://lod-cloud.net/dataset/icane> .

:assessment_fairchecker_icane_2026-04-01 a fairo:FAIRAssessment, prov:Activity ;
    prov:used :dataset_icane ;
    prov:startedAtTime "2026-04-01T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-04-01T00:00:00Z"^^xsd:dateTime ;
    fairo:usesAggregationMethod :faircheckerAggregateNormalization .

:assessment_fairchecker_icane_2026-04-01
    fairo:fScore "0.75"^^xsd:decimal ;
    fairo:aScore "0.5"^^xsd:decimal ;
    fairo:iScore "0.666667"^^xsd:decimal ;
    fairo:rScore "0.666667"^^xsd:decimal ;
