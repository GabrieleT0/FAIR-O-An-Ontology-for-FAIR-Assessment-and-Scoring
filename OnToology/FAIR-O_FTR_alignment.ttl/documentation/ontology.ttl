@prefix : <https://w3id.org/fair-o/ftr-alignment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/fair-o/ftr-alignment#> .

<https://w3id.org/fair-o/ftr-alignment> rdf:type owl:Ontology ;
                                         owl:imports <https://w3id.org/fair-o> ;
                                         <http://purl.org/dc/terms/created> "2026-06-15"^^xsd:date ;
                                         <http://purl.org/dc/terms/creator> "Gabriele Tuozzo and Maria Angela Pellegrino" ;
                                         <http://purl.org/dc/terms/description> "Alignment between FAIR-O and the FAIR Testing Resource Vocabulary. The mappings are intentionally conservative because FAIR-O is assessment-outcome-centric, while FTR is test- and benchmark-centric."@en ;
                                         <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                         <http://purl.org/dc/terms/title> "FAIR-O to FTR Alignment Module"@en ;
                                         rdfs:comment "This module provides machine-readable mappings between FAIR-O and FTR without changing the FAIR-O core ontology. Since several concepts are related but not logically equivalent, skos:closeMatch is used instead of owl:equivalentClass."@en ;
                                         rdfs:seeAlso <https://ostrails.github.io/FAIR_testing_resource_vocabulary/release/1.2.0/index-en.html> .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/fair-o#AggregationMethod
<https://w3id.org/fair-o#AggregationMethod> rdf:type owl:NamedIndividual ;
                                            <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ftr#ScoringAlgorithm> ;
                                            rdfs:comment "A FAIR-O aggregation method describes how sub-principle or principle scores are combined into aggregate FAIR scores."@en .


###  https://w3id.org/fair-o#CalculationAlgorithm
<https://w3id.org/fair-o#CalculationAlgorithm> rdf:type owl:NamedIndividual ;
                                               <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ftr#ScoringAlgorithm> ;
                                               rdfs:comment "A FAIR-O calculation algorithm is aligned with FTR scoring algorithms, but FAIR-O uses it specifically to describe how a sub-principle result is computed."@en .


###  https://w3id.org/fair-o#FAIRAssessment
<https://w3id.org/fair-o#FAIRAssessment> rdf:type owl:NamedIndividual ;
                                         <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ftr#TestResultSet> ;
                                         rdfs:comment "A FAIR-O assessment groups interpreted FAIR assessment outcomes for one assessed digital object. It can be related to an FTR result set when test-level execution details are available."@en .


###  https://w3id.org/fair-o#SubPrincipleResult
<https://w3id.org/fair-o#SubPrincipleResult> rdf:type owl:NamedIndividual ;
                                             <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ftr#TestResult> ;
                                             rdfs:comment "A FAIR-O sub-principle result may be derived from one or more FTR test results, but it is normalized at the FAIR sub-principle level rather than at the individual test level."@en .


###  https://w3id.org/ftr#ScoringAlgorithm
<https://w3id.org/ftr#ScoringAlgorithm> rdf:type owl:NamedIndividual .


###  https://w3id.org/ftr#TestResult
<https://w3id.org/ftr#TestResult> rdf:type owl:NamedIndividual .


###  https://w3id.org/ftr#TestResultSet
<https://w3id.org/ftr#TestResultSet> rdf:type owl:NamedIndividual .


