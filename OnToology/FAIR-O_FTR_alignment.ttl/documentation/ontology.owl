<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/fair-o/ftr-alignment#"
     xml:base="https://w3id.org/fair-o/ftr-alignment"
     xmlns:x="http://purl.org/nanopub/x/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/"
     xmlns:nschema="http://www.nanopub.org/nschema#">
    <owl:Ontology rdf:about="https://w3id.org/fair-o/ftr-alignment">
        <owl:imports rdf:resource="https://w3id.org/fair-o"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-15</terms:created>
        <terms:creator>Gabriele Tuozzo and Maria Angela Pellegrino</terms:creator>
        <terms:description xml:lang="en">Alignment between FAIR-O and the FAIR Testing Resource Vocabulary. The mappings are intentionally conservative because FAIR-O is assessment-outcome-centric, while FTR is test- and benchmark-centric.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">FAIR-O to FTR Alignment Module</terms:title>
        <rdfs:comment xml:lang="en">This module provides machine-readable mappings between FAIR-O and FTR without changing the FAIR-O core ontology. Since several concepts are related but not logically equivalent, skos:closeMatch is used instead of owl:equivalentClass.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://ostrails.github.io/FAIR_testing_resource_vocabulary/release/1.2.0/index-en.html"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/fair-o#AggregationMethod -->


    <owl:NamedIndividual rdf:about="https://w3id.org/fair-o#AggregationMethod">
        <skos:closeMatch rdf:resource="https://w3id.org/ftr#ScoringAlgorithm"/>
        <rdfs:comment xml:lang="en">A FAIR-O aggregation method describes how sub-principle or principle scores are combined into aggregate FAIR scores.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/fair-o#CalculationAlgorithm -->


    <owl:NamedIndividual rdf:about="https://w3id.org/fair-o#CalculationAlgorithm">
        <skos:closeMatch rdf:resource="https://w3id.org/ftr#ScoringAlgorithm"/>
        <rdfs:comment xml:lang="en">A FAIR-O calculation algorithm is aligned with FTR scoring algorithms, but FAIR-O uses it specifically to describe how a sub-principle result is computed.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/fair-o#FAIRAssessment -->


    <owl:NamedIndividual rdf:about="https://w3id.org/fair-o#FAIRAssessment">
        <skos:closeMatch rdf:resource="https://w3id.org/ftr#TestResultSet"/>
        <rdfs:comment xml:lang="en">A FAIR-O assessment groups interpreted FAIR assessment outcomes for one assessed digital object. It can be related to an FTR result set when test-level execution details are available.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/fair-o#SubPrincipleResult -->


    <owl:NamedIndividual rdf:about="https://w3id.org/fair-o#SubPrincipleResult">
        <skos:closeMatch rdf:resource="https://w3id.org/ftr#TestResult"/>
        <rdfs:comment xml:lang="en">A FAIR-O sub-principle result may be derived from one or more FTR test results, but it is normalized at the FAIR sub-principle level rather than at the individual test level.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ftr#ScoringAlgorithm -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ftr#ScoringAlgorithm"/>
    


    <!-- https://w3id.org/ftr#TestResult -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ftr#TestResult"/>
    


    <!-- https://w3id.org/ftr#TestResultSet -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ftr#TestResultSet"/>
</rdf:RDF>



