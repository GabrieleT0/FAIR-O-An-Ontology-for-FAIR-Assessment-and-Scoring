  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "A FAIR assessment must have exactly one Findable score between 0 and 1."
  } ],
  "http://www.w3.org/ns/shacl#minCount" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "http://www.w3.org/ns/shacl#minInclusive" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "0.0"
  } ],
  "http://www.w3.org/ns/shacl#path" : [ {
    "@id" : "https://w3id.org/fair-o#fScore"
  } ]
}, {
  "@id" : "_:genid25",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "The assessment start time must not be later than the assessment end time."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX prov: <http://www.w3.org/ns/prov#>\n\n            SELECT $this\n            WHERE {\n                $this prov:startedAtTime ?start ;\n                      prov:endedAtTime ?end .\n                FILTER (?start > ?end)\n            }\n        "
  } ]
}, {
  "@id" : "_:genid26",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "The overall FAIR score must not be greater than the sum of the F, A, I, and R scores."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:fairScore ?fair ;\n                      fairo:fScore ?f ;\n                      fairo:aScore ?a ;\n                      fairo:iScore ?i ;\n                      fairo:rScore ?r .\n                FILTER (?fair > (?f + ?a + ?i + ?r))\n            }\n        "
  } ]
}, {
  "@id" : "_:genid27",
  "http://www.w3.org/ns/shacl#in" : [ {
    "@id" : "_:genid28"
  } ],
  "http://www.w3.org/ns/shacl#maxCount" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "A FAIR sub-principle may specify whether it applies to data, metadata, or both."
  } ],
  "http://www.w3.org/ns/shacl#path" : [ {
    "@id" : "https://w3id.org/fair-o#appliesTo"
  } ]
}, {
  "@id" : "_:genid29",
