}, {
  "@id" : "_:genid41",
  "http://www.w3.org/ns/shacl#class" : [ {
    "@id" : "https://w3id.org/fair-o#CalculationAlgorithm"
  } ],
  "http://www.w3.org/ns/shacl#maxCount" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "Every sub-principle result must be computed using exactly one calculation algorithm."
  } ],
  "http://www.w3.org/ns/shacl#minCount" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "http://www.w3.org/ns/shacl#path" : [ {
    "@id" : "https://w3id.org/fair-o#computedUsing"
  } ]
}, {
  "@id" : "_:genid42",
  "http://www.w3.org/ns/shacl#class" : [ {
    "@id" : "https://w3id.org/fair-o#FAIRAssessment"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "Every sub-principle result must be linked from at least one FAIR assessment."
  } ],
  "http://www.w3.org/ns/shacl#minCount" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "http://www.w3.org/ns/shacl#path" : [ {
    "@id" : "_:genid43"
  } ]
}, {
  "@id" : "_:genid43",
  "http://www.w3.org/ns/shacl#inversePath" : [ {
    "@id" : "https://w3id.org/fair-o#hasSubPrincipleResult"
  } ]
}, {
  "@id" : "_:genid44",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "If testResult is Pass, the value must be exactly 1.0."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:testResult fairo:Pass ;\n                      fairo:value ?value .\n                FILTER (?value != 1.0)\n            }\n        "
  } ]
}, {
  "@id" : "_:genid45",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "If testResult is Fail, the value must be exactly 0.0."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:testResult fairo:Fail ;\n                      fairo:value ?value .\n                FILTER (?value != 0.0)\n            }\n        "
  } ]
}, {
  "@id" : "_:genid46",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "If testResult is Indeterminate, the value must be greater than 0 and less than 1."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:testResult fairo:Indeterminate ;\n                      fairo:value ?value .\n                FILTER (?value <= 0.0 || ?value >= 1.0)\n            }\n        "
  } ]
}, {
  "@id" : "_:genid47",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "The assessment scope of a sub-principle result must be consistent with the scope declared for the corresponding FAIR sub-principle, when such scope is declared."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:forSubPrinciple ?subPrinciple ;\n                      fairo:assessmentScope ?resultScope .\n\n                ?subPrinciple fairo:appliesTo ?expectedScope .\n\n                FILTER (?resultScope != ?expectedScope)\n            }\n        "
  } ]
}, {
  "@id" : "_:genid48",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "Each sub-principle result must have a complete computation chain: calculation algorithm, scoring function, and implementing software agent."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:computedUsing ?algorithm .\n                FILTER (\n                    NOT EXISTS { ?algorithm fairo:appliesScoringFunction ?scoringFunction . }\n                    ||\n                    NOT EXISTS { ?algorithm fairo:implementedBy ?softwareAgent . }\n                )\n            }\n        "
  } ]
}, {
  "@id" : "_:genid5",
  "http://www.w3.org/ns/shacl#class" : [ {
    "@id" : "https://w3id.org/fair-o#FAIRAssessment"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "A resource assessed by fairo:wasAssessedBy must point to a FAIR assessment."
  } ],
  "http://www.w3.org/ns/shacl#minCount" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "http://www.w3.org/ns/shacl#path" : [ {
