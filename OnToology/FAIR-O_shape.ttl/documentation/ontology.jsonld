    "@value" : "1"
  } ],
  "http://www.w3.org/ns/shacl#path" : [ {
    "@id" : "https://w3id.org/fair-o#formula"
  } ]
}, {
  "@id" : "_:genid32",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "The minimum value of a scoring function must not be greater than its maximum value."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:minValue ?min ;\n                      fairo:maxValue ?max .\n                FILTER (?min > ?max)\n            }\n        "
  } ]
}, {
  "@id" : "_:genid33",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/shacl#SPARQLConstraint"
  } ],
  "http://www.w3.org/ns/shacl#message" : [ {
    "@value" : "A scoring function used for FAIR-O sub-principle values must have a minimum value >= 0 and a maximum value <= 1."
  } ],
  "http://www.w3.org/ns/shacl#select" : [ {
    "@value" : "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:minValue ?min ;\n                      fairo:maxValue ?max .\n                FILTER (?min < 0.0 || ?max > 1.0)\n            }\n        "
  } ]
}, {
  "@id" : "_:genid34",
  "http://www.w3.org/ns/shacl#in" : [ {
    "@id" : "_:genid35"
  } ],
  "http://www.w3.org/ns/shacl#maxCount" : [ {
