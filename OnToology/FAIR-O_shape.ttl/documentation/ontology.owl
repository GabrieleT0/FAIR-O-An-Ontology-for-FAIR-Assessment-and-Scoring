        <shacl:sparql rdf:nodeID="genid48"/>
        <shacl:targetClass rdf:resource="https://w3id.org/fair-o#SubPrincipleResult"/>
    </NamedIndividual>
    <rdf:Description rdf:nodeID="genid34">
        <shacl:in>
            <rdf:Description/>
        </shacl:in>
        <shacl:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:maxCount>
        <shacl:message>A sub-principle result must have exactly one test outcome: Pass, Fail, or Indeterminate.</shacl:message>
        <shacl:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minCount>
        <shacl:path rdf:resource="https://w3id.org/fair-o#testResult"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid36">
        <shacl:class rdf:resource="https://w3id.org/fair/principles/terms/FAIR-SubPrinciple"/>
        <shacl:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:maxCount>
        <shacl:message>A sub-principle result must refer to exactly one FAIR sub-principle.</shacl:message>
        <shacl:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minCount>
        <shacl:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <shacl:path rdf:resource="https://w3id.org/fair-o#forSubPrinciple"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid37">
        <shacl:in>
            <rdf:Description/>
        </shacl:in>
        <shacl:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:maxCount>
        <shacl:message>A sub-principle result must specify exactly one assessment scope.</shacl:message>
        <shacl:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minCount>
        <shacl:path rdf:resource="https://w3id.org/fair-o#assessmentScope"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid39">
        <shacl:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <shacl:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:maxCount>
        <shacl:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</shacl:maxInclusive>
        <shacl:message>A sub-principle result must have exactly one decimal value between 0 and 1.</shacl:message>
        <shacl:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minCount>
        <shacl:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</shacl:minInclusive>
        <shacl:path rdf:resource="https://w3id.org/fair-o#value"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid40">
        <shacl:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <shacl:message>A sub-principle result must include non-empty textual evidence.</shacl:message>
        <shacl:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minCount>
        <shacl:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minLength>
        <shacl:path rdf:resource="https://w3id.org/fair-o#evidence"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid41">
        <shacl:class rdf:resource="https://w3id.org/fair-o#CalculationAlgorithm"/>
        <shacl:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:maxCount>
        <shacl:message>Every sub-principle result must be computed using exactly one calculation algorithm.</shacl:message>
        <shacl:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minCount>
        <shacl:path rdf:resource="https://w3id.org/fair-o#computedUsing"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid42">
        <shacl:class rdf:resource="https://w3id.org/fair-o#FAIRAssessment"/>
        <shacl:message>Every sub-principle result must be linked from at least one FAIR assessment.</shacl:message>
        <shacl:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</shacl:minCount>
        <shacl:path>
            <rdf:Description>
                <shacl:inversePath rdf:resource="https://w3id.org/fair-o#hasSubPrincipleResult"/>
            </rdf:Description>
        </shacl:path>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid44">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <shacl:message>If testResult is Pass, the value must be exactly 1.0.</shacl:message>
        <shacl:select>
            PREFIX fairo: &lt;https://w3id.org/fair-o#&gt;

            SELECT $this
            WHERE {
                $this fairo:testResult fairo:Pass ;
                      fairo:value ?value .
                FILTER (?value != 1.0)
            }
        </shacl:select>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid45">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <shacl:message>If testResult is Fail, the value must be exactly 0.0.</shacl:message>
        <shacl:select>
            PREFIX fairo: &lt;https://w3id.org/fair-o#&gt;

            SELECT $this
            WHERE {
                $this fairo:testResult fairo:Fail ;
                      fairo:value ?value .
                FILTER (?value != 0.0)
            }
        </shacl:select>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid46">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <shacl:message>If testResult is Indeterminate, the value must be greater than 0 and less than 1.</shacl:message>
        <shacl:select>
            PREFIX fairo: &lt;https://w3id.org/fair-o#&gt;

            SELECT $this
            WHERE {
                $this fairo:testResult fairo:Indeterminate ;
                      fairo:value ?value .
                FILTER (?value &lt;= 0.0 || ?value &gt;= 1.0)
            }
        </shacl:select>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid47">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <shacl:message>The assessment scope of a sub-principle result must be consistent with the scope declared for the corresponding FAIR sub-principle, when such scope is declared.</shacl:message>
        <shacl:select>
            PREFIX fairo: &lt;https://w3id.org/fair-o#&gt;

            SELECT $this
            WHERE {
                $this fairo:forSubPrinciple ?subPrinciple ;
                      fairo:assessmentScope ?resultScope .

                ?subPrinciple fairo:appliesTo ?expectedScope .

                FILTER (?resultScope != ?expectedScope)
            }
        </shacl:select>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid48">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
        <shacl:message>Each sub-principle result must have a complete computation chain: calculation algorithm, scoring function, and implementing software agent.</shacl:message>
        <shacl:select>
            PREFIX fairo: &lt;https://w3id.org/fair-o#&gt;

            SELECT $this
            WHERE {
                $this fairo:computedUsing ?algorithm .
                FILTER (
                    NOT EXISTS { ?algorithm fairo:appliesScoringFunction ?scoringFunction . }
                    ||
                    NOT EXISTS { ?algorithm fairo:implementedBy ?softwareAgent . }
                )
            }
        </shacl:select>
    </rdf:Description>
    


