_:genid26 <http://www.w3.org/ns/shacl#select> "\n            PREFIX fairo: <https://w3id.org/fair-o#>\n\n            SELECT $this\n            WHERE {\n                $this fairo:fairScore ?fair ;\n                      fairo:fScore ?f ;\n                      fairo:aScore ?a ;\n                      fairo:iScore ?i ;\n                      fairo:rScore ?r .\n                FILTER (?fair > (?f + ?a + ?i + ?r))\n            }\n        " .
